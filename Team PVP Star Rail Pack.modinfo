<?xml version="1.0" ?>
<Mod id="DF0E3C1A-E572-1868-FBE9-C58E0671151F" version="1201">
	<Properties>
		<Name>Team PVP [COLOR:ResCultureLabelCS]次元破壁：星穹铁道[ENDCOLOR]</Name>
		<Description>这是以崩坏：星穹铁道世界观为背景的文明6模组整合包。</Description>
		<Teaser>愿此行，终抵群星</Teaser>
		<Authors>Nwflower, Pen, 千川白浪, 榊野木乃实，Kotomi，PhantomJ_M</Authors>
		<SpecialThanks>Anqing, Dr.Boom, HSbF6HSO3F, IthildinX, JiDong, Nea•baraja, Oliver, Ophidy, SiQi, World·Dream, Yuni, 梦幻星尘羽，优妮酱</SpecialThanks>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
	</Properties>
	<Dependencies>
		<Mod id="1B28771A-C749-434B-9053-D1380C553DE9" title="LOC_EXPANSION1_MOD_TITLE"/>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
