<?xml version="1.0" ?>
<Mod id="DF0E3C1A-E572-1868-FBE9-C58E0671151F" version="1111">
	<Properties>
		<Name>Team PVP [COLOR:ResCultureLabelCS]次元破壁：星穹铁道[ENDCOLOR]</Name>
		<Description>这是以崩坏：星穹铁道世界观为背景的文明6模组整合包。</Description>
		<Teaser>愿此行，终抵群星</Teaser>
		<Authors>{LOC_AMPHOREUS_MOD_AUTHORS}, {LOC_KNM_HERTA_MOD_AUTHOR}, Nwflower</Authors>
		<SpecialThanks>Anqing, HSbF6HSO3F, {LOC_KNM_HERTA_MOD_THANKS}, Ophidy, SiQi, World·Dream, Yuni</SpecialThanks>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
	</Properties>
	<Dependencies>
		<Mod id="1B28771A-C749-434B-9053-D1380C553DE9" title="LOC_EXPANSION1_MOD_TITLE"/>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
	</Dependencies>
	<References>
		<Mod id="1B28771A-C749-434B-9053-D1380C553DE9" title="Expansion: Rise and Fall"/>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm"/>
	</References>
	<ActionCriteria>
		<Criteria id="Amphoreus">
			<LeaderPlayable>Players:StandardPlayers::LEADER_NW_Tribios,StandardPlayers::LEADER_NW_Tribios,Players:Expansion1_Players::LEADER_NW_Tribios,Players:Expansion2_Players::LEADER_NW_Tribios</LeaderPlayable>
			<RuleSetInUse>RULESET_STANDARD,RULESET_EXPANSION_1,RULESET_EXPANSION_2</RuleSetInUse>
		</Criteria>
		<Criteria id="Amphoreus_Expansion1">
			<LeaderPlayable>Players:Expansion1_Players::LEADER_NW_Tribios</LeaderPlayable>
			<RuleSetInUse>RULESET_EXPANSION_1</RuleSetInUse>
		</Criteria>
		<Criteria id="Amphoreus_Expansion2">
			<LeaderPlayable>Players:Expansion2_Players::LEADER_NW_Tribios</LeaderPlayable>
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
		</Criteria>
		<Criteria id="SecretSocieties">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>GAMEMODE_SECRETSOCIETIES</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="LeaderCriteria">
			<LeaderPlayable>Players:Expansion2_Players::LEADER_KNM_HERTA,Players:Expansion2_Players::LEADER_KNM_ASTA</LeaderPlayable>
		</Criteria>
		<Criteria id="SecretSociety">
			<ConfigurationValueMatches>
				<ConfigurationId>GAMEMODE_SECRETSOCIETIES</ConfigurationId>
				<Group>Game</Group>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="Apocalypse">
			<ConfigurationValueMatches>
				<ConfigurationId>GAMEMODE_APOCALYPSE</ConfigurationId>
				<Group>Game</Group>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="KublaiKhan_Vietnam">
			<ModInUse>A3F42CD4-6C3E-4F5A-BC81-BE29E0C0B87C</ModInUse>
		</Criteria>
		<Criteria id="Ethiopia">
			<ModInUse>1B394FE9-23DC-4868-8F0A-5220CB8FB427</ModInUse>
		</Criteria>
		<Criteria id="Expansion2">
